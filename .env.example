# Copy to .env.local (development) or set on your server (production).

# Signs admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# First admin account. Used only once, to create the owner on first sign-in.
# Change the password afterwards in Admin → My account.
ADMIN_EMAIL=cap.dhk@gmail.com
ADMIN_PASSWORD=

# The admin is hidden from the official site. List the address(es) where it may open,
# e.g. a subdomain pointed at this same server. In production the admin stays closed until this is set.
ADMIN_HOSTS=admin.cap.direct
# Optional: the admin's full URL, used in password-reset emails
ADMIN_URL=https://admin.cap.direct

# "Forgot password" emails. For Gmail, turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cap.dhk@gmail.com
SMTP_PASS=
MAIL_FROM=CAP website <cap.dhk@gmail.com>

# Public URL (used for SEO, sitemap and share links)
NEXT_PUBLIC_SITE_URL=https://www.cap.direct

# Optional: keep content, private data and media outside the app folder
# (useful so redeploys never touch uploaded work)
# CONTENT_DIR=/var/cap/content
# DATA_DIR=/var/cap/data
# MEDIA_DIR=/var/cap/media
