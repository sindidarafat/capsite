# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CAP: private runtime data (admin users, inquiries, backups)
/data/

# CAP: master video files are too big for GitHub (100 MB limit). The site uses the
# compressed web versions; keep the masters on the server / a drive instead.
/media/showreel/jolphool-subbed-final.mp4
/media/uploads/jolphool-subbed-final.mp4
